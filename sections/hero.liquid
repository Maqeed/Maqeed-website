<section class="hero" {% if section.settings.image %}style="background-image:url({{ section.settings.image | image_url: width: 2400 }});"{% endif %}>
  <div class="wrap hero__inner">
    {%- if section.settings.show_wordmark -%}
      <img src="{{ 'wordmark.png' | asset_url }}" alt="{{ shop.name }}" class="hero__wordmark" loading="eager">
    {%- endif -%}

    <div class="hero__bottom">
      <p class="hero__text">
        {{ section.settings.text }}
      </p>
      <a href="#{{ section.settings.scroll_to | default: 'story' }}" class="hero__scroll">scroll</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show wordmark",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Hero text",
      "default": "<p>The name means <em>held</em> — a scent that keeps its shape on skin instead of announcing itself and leaving. Four fragrances, blurred from any single note, poured slow.</p>"
    },
    {
      "type": "text",
      "id": "scroll_to",
      "label": "Scroll-to anchor id",
      "default": "story"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
