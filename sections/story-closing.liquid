{%- comment -%}
  Editorial closing section for a brand-story page: heading + short
  paragraph, followed by an optional large image that acts as the
  visual conclusion of the story.
{%- endcomment -%}
<section class="story-closing">
  <div class="wrap wrap--narrow story-closing__text" data-reveal>
    <h2 class="font-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <div class="story-closing__body rte">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn-link">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.image -%}
    <div class="story-closing__media story-closing__media--{{ section.settings.height }}"
      style="--story-closing-desktop: url('{{ section.settings.image | image_url: width: 2200 }}');{% if section.settings.image_mobile %} --story-closing-mobile: url('{{ section.settings.image_mobile | image_url: width: 1200 }}');{% endif %}">
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Story closing",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A delight for the senses"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>To wear Maqeed is to experience more than scent — it's a memory returning unannounced, and an invitation to notice, remember, and return to what matters.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (optional)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Image height",
      "options": [
        { "value": "height-small", "label": "Small" },
        { "value": "height-medium", "label": "Medium" },
        { "value": "height-large", "label": "Large" }
      ],
      "default": "height-medium"
    }
  ],
  "presets": [
    { "name": "Story closing" }
  ]
}
{% endschema %}
