<section class="composition" id="notes">
  <div class="wrap">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="font-heading">{{ section.settings.heading }}</h2>

    <div class="notes-columns">
      {%- for block in section.blocks -%}
        <div class="notes-col" {{ block.shopify_attributes }}>
          <p class="notes-col__title font-heading">{{ block.settings.title }}</p>
          <ul class="notes-col__list">
            {%- assign items = block.settings.items | split: "\n" -%}
            {%- for item in items -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                <li>{{ trimmed }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Composition",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "composition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A fragrance built in three layers" }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Top" },
        {
          "type": "textarea",
          "id": "items",
          "label": "Notes (one per line)",
          "default": "Black pepper\nBitter bergamot\nPink cardamom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Composition",
      "blocks": [
        { "type": "layer", "settings": { "title": "Top", "items": "Black pepper\nBitter bergamot\nPink cardamom" } },
        { "type": "layer", "settings": { "title": "Heart", "items": "Aged oud\nSaffron leather\nDried rose" } },
        { "type": "layer", "settings": { "title": "Base", "items": "Dark amber\nSandalwood\nWarm skin musk" } }
      ]
    }
  ]
}
{% endschema %}
