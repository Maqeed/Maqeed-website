{%- comment -%}
  Premium showcase for merchant-selected products (not a whole collection).
  Each block picks one real Shopify product via a product picker, so
  everything shown — image, title, type, price, url — comes from
  live product data.
{%- endcomment -%}
<section class="featured-fragrances" style="--featured-bg: {{ section.settings.background_color }};">
  <div class="wrap">
    <div class="featured-fragrances__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="font-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <div class="featured-fragrances__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="featured-grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          <a href="{{ product.url }}" class="featured-card" data-reveal {{ block.shopify_attributes }}>
            <div class="featured-card__image">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 1000 }}"
                     alt="{{ product.featured_image.alt | escape }}"
                     width="500" height="625" loading="lazy">
              {%- endif -%}
            </div>
            <p class="featured-card__type">{{ product.type | default: 'Eau de Parfum' }}</p>
            <h3 class="featured-card__title font-heading">{{ product.title }}</h3>
            <p class="featured-card__price">
              {%- if product.price_varies -%}
                {{ 'products.product.regular_price' | t }} {{ product.price_min | money }}
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            </p>
          </a>
        {%- elsif request.design_mode -%}
          <div class="featured-card featured-card--empty" {{ block.shopify_attributes }}>
            <div class="featured-card__image"></div>
            <p class="featured-card__type">Eau de Parfum</p>
            <h3 class="featured-card__title font-heading">Select a product</h3>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured fragrances",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Defaults to a rosewood tone that echoes the footer while staying distinct from it.",
      "default": "#2B1419"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "the collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Fragrances"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Two fragrances, poured slow.</p>"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured fragrances",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
