<section class="account-page">
  <div class="wrap wrap--narrow">
    <h1 class="font-heading">Reset password</h1>
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}
        <p class="form-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <input type="password" name="customer[password]" placeholder="New password" required>
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required>
      <button type="submit" class="btn-primary">Reset password</button>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
