{%- comment -%}
  Large image-led editorial section: a big image (with an optional
  separate mobile crop) followed by a short, centered text block.
  Built for storytelling pages where the image should dominate and
  the copy stays minimal.
{%- endcomment -%}
<section class="story-image-block">
  <div class="story-image-block__media story-image-block__media--{{ section.settings.height }}{% unless section.settings.image %} story-image-block__media--empty{% endunless %}"
    {% if section.settings.image %}
      style="--story-image-desktop: url('{{ section.settings.image | image_url: width: 2200 }}');{% if section.settings.image_mobile %} --story-image-mobile: url('{{ section.settings.image_mobile | image_url: width: 1200 }}');{% endif %}"
    {% endif %}>
  </div>

  {%- if section.settings.heading != blank or section.settings.body != blank -%}
    <div class="wrap wrap--narrow story-image-block__text" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="font-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="story-image-block__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Story image",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Image height",
      "options": [
        { "value": "height-small", "label": "Small" },
        { "value": "height-medium", "label": "Medium" },
        { "value": "height-large", "label": "Large" }
      ],
      "default": "height-large"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "presets": [
    { "name": "Story image" }
  ]
}
{% endschema %}
