<section class="philosophy-ritual" id="ritual">
  <div class="wrap wrap--narrow">
    <h2 class="font-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="philosophy-ritual__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="steps steps--framed">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <span class="step__number step__number--roman">{{ block.settings.numeral }}</span>
          <h3 class="step__title font-heading">{{ block.settings.title }}</h3>
          <div class="step__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy ritual",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The ritual" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Extrait concentrations need warmth to open. This is how we wear ours."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "numeral", "label": "Numeral", "default": "i." },
        { "type": "text", "id": "title", "label": "Title", "default": "Warm the point" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Wrists, the base of the throat, behind the ear — anywhere skin runs close to the surface.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy ritual",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "numeral": "i.",
            "title": "Warm the point",
            "text": "<p>Wrists, the base of the throat, behind the ear — anywhere skin runs close to the surface.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "ii.",
            "title": "Press, don't rub",
            "text": "<p>Friction breaks the top notes early. Let the oil settle into skin on its own.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "iii.",
            "title": "Give it a minute",
            "text": "<p>The alcohol lifts first. What's left after is the scent that actually stays.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
