<section class="blog">
  <div class="wrap">
    <p class="eyebrow">journal</p>
    <h1 class="font-heading">{{ blog.title }}</h1>

    <div class="blog-list">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="blog-card">
          {%- if article.image -%}
            <div class="blog-card__image">
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" width="400" height="300" loading="lazy">
            </div>
          {%- endif -%}
          <h3 class="font-heading">{{ article.title }}</h3>
          <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          <span class="blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
