{%- comment -%}
  Full-width cinematic image section. Image dominates; text and CTA
  are optional and minimal by design.
{%- endcomment -%}
<section class="campaign-image campaign-image--{{ section.settings.height }}"
         {% if section.settings.image %}style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}');"{% endif %}>
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="campaign-image__overlay" style="opacity: {{ section.settings.overlay_opacity | times: 1.0 | divided_by: 100 }};"></div>
  {%- endif -%}

  {%- if section.settings.heading != blank or section.settings.cta_label != blank -%}
    <div class="wrap campaign-image__content" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="font-heading campaign-image__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="btn-link campaign-image__cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Campaign image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Text",
      "default": "MAQEED — BETWEEN MEMORY & PLACE"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label (optional)"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "height-small", "label": "Small" },
        { "value": "height-medium", "label": "Medium" },
        { "value": "height-large", "label": "Large" }
      ],
      "default": "height-medium"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    }
  ],
  "presets": [
    { "name": "Campaign image" }
  ]
}
{% endschema %}
