<footer class="site-footer">
  <div class="wrap site-footer__top" data-reveal>
    <p class="site-footer__wordmark font-heading">{{ settings.logo_text | default: shop.name }}</p>
    {%- if section.settings.statement != blank -%}
      <p class="site-footer__statement">{{ section.settings.statement }}</p>
    {%- endif -%}
  </div>

  <div class="wrap site-footer__nav" data-reveal>
    <div class="footer-col">
      <p class="footer-col__title">{{ section.settings.shop_title }}</p>
      <ul>
        {%- if section.settings.shop_link_label != blank -%}
          <li><a href="{{ section.settings.shop_link_url | default: '#' }}">{{ section.settings.shop_link_label }}</a></li>
        {%- endif -%}
      </ul>
    </div>
    <div class="footer-col">
      <p class="footer-col__title">{{ section.settings.brand_title }}</p>
      <ul>
        {%- if section.settings.brand_link_1_label != blank -%}
          <li><a href="{{ section.settings.brand_link_1_url | default: '/pages/our-story' }}">{{ section.settings.brand_link_1_label }}</a></li>
        {%- endif -%}
        {%- if section.settings.brand_link_2_label != blank -%}
          <li><a href="{{ section.settings.brand_link_2_url | default: '/pages/contact' }}">{{ section.settings.brand_link_2_label }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__newsletter" data-reveal>
    <h2 class="font-heading">{{ section.settings.newsletter_heading }}</h2>
    {%- if section.settings.newsletter_description != blank -%}
      <p class="site-footer__newsletter-description">{{ section.settings.newsletter_description }}</p>
    {%- endif -%}

    {% form 'customer', class: 'site-footer__newsletter-form' %}
      {%- if form.posted_successfully? -%}
        <p class="site-footer__newsletter-success">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="site-footer__newsletter-field">
          <label for="FooterNewsletterEmail" class="visually-hidden">Email</label>
          <input type="email" name="contact[email]" id="FooterNewsletterEmail" placeholder="your email" required>
          <button type="submit" aria-label="Subscribe">
            {% render 'icon-arrow' %}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="site-footer__newsletter-error">{{ form.errors.messages['contact[email]'] }}</p>
        {%- endif -%}
      {%- endif -%}
    {% endform %}
  </div>

  {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
    <div class="wrap site-footer__social" data-reveal>
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
      {%- endif -%}
      {%- if settings.social_tiktok != blank -%}
        <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="wrap site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <p>{{ section.settings.bottom_right }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Brand statement",
      "default": "Fragrance, shaped by memory."
    },
    {
      "type": "header",
      "content": "Shop column"
    },
    {
      "type": "text",
      "id": "shop_title",
      "label": "Column title",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "shop_link_label",
      "label": "Link label",
      "default": "All Fragrances"
    },
    {
      "type": "url",
      "id": "shop_link_url",
      "label": "Link URL",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Maqeed column"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Column title",
      "default": "Maqeed"
    },
    {
      "type": "text",
      "id": "brand_link_1_label",
      "label": "Link 1 label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "brand_link_1_url",
      "label": "Link 1 URL",
      "info": "Defaults to /pages/our-story if left blank."
    },
    {
      "type": "text",
      "id": "brand_link_2_label",
      "label": "Link 2 label",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "brand_link_2_url",
      "label": "Link 2 URL",
      "info": "Defaults to /pages/contact if left blank."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Stay close to Maqeed."
    },
    {
      "type": "text",
      "id": "newsletter_description",
      "label": "Description",
      "default": "New fragrances, stories and private releases."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_right",
      "label": "Bottom right text",
      "default": "UAE · English"
    }
  ]
}
{% endschema %}
