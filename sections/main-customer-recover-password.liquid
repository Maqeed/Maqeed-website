<section class="account-page">
  <div class="wrap wrap--narrow">
    <h1 class="font-heading">{{ 'customer.recover_password.title' | t }}</h1>
    {% form 'recover_customer_password' %}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="form-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <input type="email" name="email" placeholder="{{ 'customer.recover_password.email' | t }}" required>
      <button type="submit" class="btn-primary">{{ 'customer.recover_password.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Recover password", "settings": [] }
{% endschema %}
