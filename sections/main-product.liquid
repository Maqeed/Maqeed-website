<section class="product">
  <div class="wrap product__inner">
    <div class="product__gallery">
      {%- if product.featured_image -%}
        <div class="product__image" data-product-main-image>
          <img src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.featured_image.alt | escape }}"
               id="ProductMainImage" width="600" height="800">
        </div>
      {%- endif -%}
      {%- if product.images.size > 1 -%}
        <div class="product__thumbs">
          {%- for image in product.images -%}
            <button type="button" class="product__thumb" data-product-thumb="{{ image | image_url: width: 1200 }}">
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" width="80" height="106" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <p class="eyebrow">{{ product.type | default: 'edp' }}</p>
      <h1 class="font-heading">{{ product.title }}</h1>
      <p class="product__price">
        {%- if product.price_varies -%}
          {{ 'products.product.regular_price' | t }} {{ product.price_min | money }} &ndash; {{ product.price_max | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>

      <div class="product__description">{{ product.description }}</div>

      {% form 'product', product, class: 'product-form', data-product-form: '' %}
        {{ form | payment_terms }}

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option">
              <label class="product-option__label">{{ option.name }}</label>
              <div class="product-option__values">
                {%- for value in option.values -%}
                  <label class="product-option__swatch">
                    <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}"
                           {% if option.selected_value == value %}checked{% endif %}
                           data-option-index="{{ option.position | minus: 1 }}">
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <select name="id" data-product-variant-select class="visually-hidden">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"
                      {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-option-values="{{ variant.options | join: '||' }}">
                {{ variant.title }} &mdash; {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endunless -%}

        <div class="product__quantity">
          <label for="ProductQuantity" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
          <input type="number" id="ProductQuantity" name="quantity" value="1" min="1">
        </div>

        <button type="submit" name="add" class="btn-primary product__add"
                {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                data-add-to-cart>
          <span data-add-to-cart-text>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
      {% endform %}

      {%- if section.settings.show_notes -%}
        <div class="product__notes">
          {%- for block in section.blocks -%}
            {%- if block.type == 'note' -%}
              <div class="product-note" {{ block.shopify_attributes }}>
                <span class="product-note__label">{{ block.settings.label }}</span>
                <span class="product-note__value">{{ block.settings.value }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Show fragrance notes list",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "top" },
        { "type": "text", "id": "value", "label": "Value", "default": "bergamot, pink pepper" }
      ]
    }
  ]
}
{% endschema %}
