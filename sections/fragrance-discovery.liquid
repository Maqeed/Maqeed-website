{%- comment -%}
  Simple, uncomplicated list of scent families, each linking out to a
  collection, product, or filtered collection URL set by the merchant.
{%- endcomment -%}
<section class="fragrance-discovery">
  <div class="wrap">
    <div class="fragrance-discovery__head" data-reveal>
      <h2 class="font-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="fragrance-discovery__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="fragrance-discovery__list" data-reveal>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="font-heading">{{ block.settings.label }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fragrance discovery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Scent"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Browse by the character that speaks to you."
    }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Scent family",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Woody" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fragrance discovery",
      "blocks": [
        { "type": "family", "settings": { "label": "Woody" } },
        { "type": "family", "settings": { "label": "Amber" } },
        { "type": "family", "settings": { "label": "Musk" } },
        { "type": "family", "settings": { "label": "Fresh" } },
        { "type": "family", "settings": { "label": "Sweet" } }
      ]
    }
  ]
}
{% endschema %}
