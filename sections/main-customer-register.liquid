<section class="account-page">
  <div class="wrap wrap--narrow">
    <h1 class="font-heading">{{ 'customer.register.title' | t }}</h1>
    {% form 'create_customer' %}
      {%- if form.errors -%}
        <p class="form-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <input type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}">
      <input type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}">
      <input type="email" name="customer[email]" placeholder="{{ 'customer.register.email' | t }}" required>
      <input type="password" name="customer[password]" placeholder="{{ 'customer.register.password' | t }}" required>
      <button type="submit" class="btn-primary">{{ 'customer.register.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
