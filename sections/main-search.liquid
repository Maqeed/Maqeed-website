<section class="search-page">
  <div class="wrap">
    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <h1 class="font-heading">
        {%- if search.results_count > 0 -%}
          {{ 'general.search.results_for' | t: terms: search.terms }}
        {%- else -%}
          {{ 'general.search.no_results' | t: terms: search.terms }}
        {%- endif -%}
      </h1>

      {%- if search.results_count > 0 -%}
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="product-card">
                <h3 class="product-card__title font-heading">{{ item.title }}</h3>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
